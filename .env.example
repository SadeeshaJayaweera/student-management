# ============================================================
# NSBM EduSphere — Environment Configuration Template
# Copy this file to .env and configure for your target environment
# ============================================================

# Environment: development, testing, staging, production
ENVIRONMENT=development
APP_NAME="NSBM EduSphere"
APP_VERSION="1.0.0"
DEBUG=true

# Security (MUST be changed in production: 32+ cryptographically random characters)
SECRET_KEY=development-insecure-secret-key-min-32-chars-for-dev-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Development default):
DATABASE_URL=sqlite+aiosqlite:///./edusphere.db
# PostgreSQL (Production / Staging):
# DATABASE_URL=postgresql+asyncpg://edusphere_user:secure_password@localhost:5432/edusphere_prod

# Google Gemini AI & Knowledge Base
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true
CHROMA_PERSIST_DIR=./chroma_db

# Redis Cache & Real-Time State
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Storage & File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Configuration (JSON array or comma-separated URLs)
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:5173","http://127.0.0.1:8000","http://127.0.0.1:5173"]

# Email / SMTP Notifications
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@nsbm.ac.lk
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Institution Metadata
INSTITUTION_NAME="NSBM Green University"
INSTITUTION_SHORT="NSBM"
INSTITUTION_WEBSITE=https://www.nsbm.ac.lk
